 void
+negroni_b_band(uint32_t color, uint32_t row)
+{
+	boot_args *args = (boot_args *) PE_state.bootArgs;
+	uint64_t base;
+	uint64_t stride;
+	uint64_t y0;
+	uint32_t x;
+	uint32_t y;
+
+	if (args == 0) { return; }
+	base = (uint64_t)args->Video.v_baseAddr;
+	stride = (uint64_t)args->Video.v_rowBytes;
+	if ((base == 0) || (stride == 0) || (args->Video.v_height < 16)) { return; }
+	y0 = (uint64_t)(args->Video.v_height / 16) * (uint64_t)row;
+	for (y = 0; y < 64; y++) {
+		for (x = 0; x < 128; x++) {
+			ml_phys_write((vm_offset_t)(base + (y0 + y) * stride + (uint64_t)x * 4), color);
+		}
+	}
+}
+
+void
 kernel_bootstrap(void)
 {
 	kern_return_t   result;
 	thread_t        thread;
 	char            namep[16];
 
 	printf("%s\n", version); /* log kernel version */
 	printf("NEGRONI B: kernel_bootstrap enter\n");
+	negroni_b_band(0xFF0000FF, 3);
 
 	scale_setup();
 
 	kernel_bootstrap_log("vm_mem_bootstrap");
 	vm_mem_bootstrap();
 
